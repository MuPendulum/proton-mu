From 175e09ef41d3126abe368ec6d98fac829bb5936b Mon Sep 17 00:00:00 2001
From: Anton Baskanov <baskanov@gmail.com>
Date: Sat, 23 May 2026 16:36:15 +0700
Subject: [PATCH 4/5] dsound: Add an SSE version of upsample.

---
 dlls/dsound/fir.h   |  4 ++--
 dlls/dsound/mixer.c | 53 ++++++++++++++++++++++++++++++++++++++++++++-
 2 files changed, 54 insertions(+), 3 deletions(-)

diff --git a/dlls/dsound/fir.h b/dlls/dsound/fir.h
index 76ac521e0f3..39a32af1412 100644
--- a/dlls/dsound/fir.h
+++ b/dlls/dsound/fir.h
@@ -90,7 +90,7 @@ int main()
