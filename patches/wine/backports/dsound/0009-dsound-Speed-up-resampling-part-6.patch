         int opos = (int)(opos_num >> FREQ_ADJUST_SHIFT) - FIR_WIDTH;
@@ -340,6 +387,7 @@ static void downsample(DWORD freq_adjust_den, DWORD freq_acc_start, float firgai
 
         opos_num += opos_num_step;
     }
+#endif
 }
 
