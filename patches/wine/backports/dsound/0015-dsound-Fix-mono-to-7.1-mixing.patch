From 914f9a300479bb0b0126984c2c2da11b1eeee567 Mon Sep 17 00:00:00 2001
From: Matteo Bruni <mbruni@codeweavers.com>
Date: Sun, 8 Nov 2026 21:00:29 +0100
Subject: [PATCH] dsound: Fix mono to 7.1 mixing.

Reported by Nicholas Ansell (@roadrunnerto) at
https://gitlab.winehq.org/wine/wine/-/merge_requests/12023#note_154578.
---
 dlls/dsound/mixer.c | 7 ++-----
 1 file changed, 2 insertions(+), 5 deletions(-)

diff --git a/dlls/dsound/mixer.c b/dlls/dsound/mixer.c
index 127ec864e51..5913e92af4b 100644
--- a/dlls/dsound/mixer.c
+++ b/dlls/dsound/mixer.c
@@ -390,6 +390,8 @@ void DSOUND_RecalcFormat(IDirectSoundBufferImpl *dsb)
 			dsb->out_channel_map = &channel_map_mono2quad;
 		else if (ochannels == 6)
 			dsb->out_channel_map = &channel_map_mono2surround51;
+                else if (ochannels == 8)
+                    dsb->out_channel_map = &channel_map_mono2surround71;
 	}
 	else if (ochannels == 1)
 	{
@@ -421,11 +423,6 @@ void DSOUND_RecalcFormat(IDirectSoundBufferImpl *dsb)
 		dsb->mix_channels = 4;
 		dsb->out_channel_map = &channel_map_quad2stereo;
 	}
-	else if (ichannels == 1 && ochannels == 8)
-	{
-		dsb->mix_channels = 1;
-		dsb->out_channel_map = &channel_map_mono2surround71;
-	}
 	else if (ichannels == 2 && ochannels == 8)
 	{
 		dsb->mix_channels = 2;
